@article{tutland_representing_2025,
	title = {Representing 3-dimensional fuels for physics-based fire behavior models: a general framework and case study in a type-converted post-fire shrubfield},
	volume = {21},
	issn = {1933-9747},
	shorttitle = {Representing 3-dimensional fuels for physics-based fire behavior models},
	url = {https://fireecology.springeropen.com/articles/10.1186/s42408-025-00383-2},
	doi = {10.1186/s42408-025-00383-2},
	abstract = {Abstract
            
              Background
              Physics-based three-dimensional (3D) fire behavior models improve planning for prescribed fire application and wildfire mitigation, but require high spatial resolution 3D fuel models as inputs. While multiple methods and data sources for realistically representing 3D, heterogeneous fuels are available, no unifying framework exists to guide the use of these tools to create 3D fuel models across gradients of vegetation characteristics and data availability. Existing data and methods are most uncertain for mid-level fuels (e.g., shrubs and small trees), due to canopy obstruction of remotely sensed data and a relative lack of modeling efforts. Yet, mid-level fuels are especially important as potential ladder fuels and increasingly common as the dominant fuel in type-converted, post-fire, shrub-dominated landscapes.
            
            
              Results
              Here we introduce the Framework for Representing 3D Fuels (FR3D), a general framework for combining multiple data sources and methods to construct 3D fuel models for forested and unforested landscapes. We then demonstrate FR3D in a case study to build a 3D fuelbed model in a post-fire, shrub-dominated landscape using three new methods for deriving mid-level shrub fuels from: (1) Airborne Laser Scanning (ALS), (2) imputation of Terrestrial Laser Scanning (TLS), and (3) generative modeling of TLS. We compare the resulting fuel models and examine how they affected simulated 3D fire behavior using QUIC-Fire. While each method represented the broad landscape patterning of shrubs, differences in shrub loading, height, and cover highlighted advantages and drawbacks of the different methods. Modeled fire behavior was realistic for all fuel representation methods, but rate of spread and fine fuel consumption was sensitive to the different arrangements of shrubs.
            
            
              Conclusions
              The sensitivity of fire behavior to shrub modeling methods emphasizes the need for fuel models that faithfully represent local fuelbed characteristics and conditions, and highlights the value in testing a range of modeled fuels to understand the potential range of prescribed fire outcomes. FR3D and novel methods of modeling mid-level fuel provide a foundation for tool integration efforts and increased site-specificity of fuel representation for physics-based fire models.
            
          , 
            Resumen
            
              Antecedentes
              Los modelos físicos de comportamiento del fuego basados en tres dimensiones (3D), mejoran el planeamiento para la aplicación de quemas prescriptas y la mitigación de los incendios, aunque requieren, como insumos, modelos de combustibles de alta resolución espacial. Aunque múltiples modelos y fuentes de datos para representar de manera real modelos 3D de combustibles heterogéneos están disponibles, no existe un patrón unificado para guiar el uso de esas herramientas para crear modelos de combustibles en 3D a través de gradientes de vegetación característicos y disponibilidad de datos. Los datos existentes y los métodos son más inciertos para combustibles medianos (i.e., arbustos y árboles pequeños), debido a la obstrucción que imponen los doseles a datos basados en sensores remotos y la falta relativa de los esfuerzos que conlleva su modelado. Aún así, los combustibles medianos son especialmente importantes como escaleras de combustible y se presentan como incrementalmente comunes en razón de convertirse en el tipo de combustible dominante en el post fuego en paisajes dominados por arbustos.
            
            
              Resultados
              Introdujimos en este trabajo el marco conceptual para representar combustibles en 3D (FR3D), un marco conceptual general para combinar distintas fuentes de datos múltiples y métodos para paisajes con y sin bosques. Luego demostramos FR3D en un estudio de caso para construir un modelo de combustible 3D para un paisaje de arbustales post fuego usando tres métodos nuevos para derivar los combustibles medianos de arbustales basados en: 1) Escaneo Láser Aerotransportado (LIDAR o ALS); 2) Imputación del Scanner Laser Terrestre (TLS); y 3) Modelo Generativo del TLS. Comparamos los modelos de combustible resultantes y examinamos cómo éstos afectan la simulación del comportamiento del fuego usando QUIC-Fire. Aunque cada método representó el amplio patrón de distribución de los combustibles arbustivos en el paisaje, las diferencias en la carga de combustible, la altura, y cobertura subrayan ventajas y desventajas de los diferentes métodos. El modelado del comportamiento del fuego fue realístico para todos los métodos de representación del combustible, aunque la tasa de propagación y el consumo del combustible fino fueron sensibles a los diferentes arreglos espaciales de los mismos arbustos.
            
            
              Conclusiones
              La sensibilidad del comportamiento del fuego a los métodos del modelado enfatiza la necesidad de modelos de combustible que representen fielmente las características y condiciones de las camas de combustibles, y subrayan el valor de probar el rango potencial de resultados en las quemas prescriptas. El FR3D y otros métodos novedosos para modelar los combustibles medianos proveen de base para la integración de esfuerzos en lo que son las herramientas, e incrementar la especificidad a nivel de sitio para la representación de los combustibles para modelos de fuego basados en variables físicas.},
	language = {en},
	number = {1},
	urldate = {2025-08-22},
	journal = {Fire Ecology},
	author = {Tutland, Niko J. and Wion, Andreas P. and May, Carolina J. and Hutchings, Grant C. and Nowak, Hope A. and Gattiker, James R. and Hiers, J. Kevin and Linn, Rodman R. and Pokswinski, Scott M. and Margolis, Ellis Q.},
	month = aug,
	year = {2025},
	pages = {43},
}

